# Base de données locale (lancée avec : docker compose up -d)
DATABASE_URL="mysql://ehtukon_user:ehtukon_pass@localhost:3307/ehtukon"

# Secrets JWT — à remplacer par de longues chaînes aléatoires en production
JWT_ACCESS_SECRET="change_me_in_production"
JWT_REFRESH_SECRET="change_me_in_production_too"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Site web (Vite)
VITE_API_URL="http://localhost:3001"

# App mobile (Expo) — adresse IP de ton PC sur le réseau local
EXPO_PUBLIC_API_URL="http://192.168.1.X:3001"

# Ancienne base (uniquement pour le script migrate-legacy, optionnel)
LEGACY_DB_HOST=""
LEGACY_DB_USER=""
LEGACY_DB_PASSWORD=""
LEGACY_DB_NAME=""
